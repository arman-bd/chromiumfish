+// ChromiumFish: when running under a Windows persona (--persona-os=win) on a
+// non-Windows host, present a Windows initial TTL / IPv6 hop-limit (128) on
+// outbound client connections. Chrome-on-Linux/macOS otherwise emits TTL 64,
+// which network-layer OS fingerprinters (p0f, and FingerprintJS's os_mismatch
+// signal) read to infer the real host OS despite the spoofed UA / platform.
+// Returns 0 when no override applies, leaving the OS default untouched.
+int PersonaHopLimitOverride() {
+  static const int hop_limit = [] {
+    return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+               "persona-os") == "win"
+               ? 128
+               : 0;
+  }();
+  return hop_limit;
+}
