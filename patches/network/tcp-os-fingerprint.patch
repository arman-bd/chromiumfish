@@ -468,6 +486,16 @@ void TCPSocketPosix::SetDefaultOptionsForClient() {
   // If SetTCPNoDelay fails, we don't care.
   SetTCPNoDelay(socket_->socket_fd(), true);
 
+  // ChromiumFish: match the persona's network-layer OS fingerprint. IPv4
+  // sockets honour IP_TTL; IPv6 sockets honour IPV6_UNICAST_HOPS. Set both and
+  // ignore the ENOPROTOOPT from the address family that does not apply.
+  if (int hop_limit = PersonaHopLimitOverride()) {
+    setsockopt(socket_->socket_fd(), IPPROTO_IP, IP_TTL, &hop_limit,
+               sizeof(hop_limit));
+    setsockopt(socket_->socket_fd(), IPPROTO_IPV6, IPV6_UNICAST_HOPS,
+               &hop_limit, sizeof(hop_limit));
+  }
