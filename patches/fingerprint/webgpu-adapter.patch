+  // Persona-fork: a real Intel Windows/macOS WebGPU adapter reports
+  // maxTextureDimension1D/2D = 16384; the SwiftShader software backend reports
+  // 8192. Align for desktop personas (confirmed vs real Windows Chrome 150).
+  if (!blink::fingerprinting::Current().ua_metadata_mobile) {
