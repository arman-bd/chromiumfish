+// Lightweight-fork: numeric seed (uint64, decimal) that selects the
+// fingerprint persona for this browser session. Read by Blink's
+// `fingerprinting::Current()` accessor; forwarded to renderers so every
+// process in the session derives the same persona.
+CONTENT_EXPORT extern const char kPersonaSeed[];
+// Lightweight-fork: static geolocation persona. Decimal-degree latitude and
+// longitude (and optional horizontal accuracy in meters) that override the
+// Geolocation API for the whole browser session, mirroring the CDP
+// Emulation.setGeolocationOverride path. Read browser-side in
+// WebContentsImpl::GetGeolocationContext(); their presence also auto-grants the
+// geolocation permission (see components/permissions/permission_context_base).
+CONTENT_EXPORT extern const char kPersonaLatitude[];
+CONTENT_EXPORT extern const char kPersonaLongitude[];
+CONTENT_EXPORT extern const char kPersonaAccuracy[];
