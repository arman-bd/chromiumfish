   if (!geolocation_context_) {
     GetDeviceService().BindGeolocationContext(
         geolocation_context_.BindNewPipeAndPassReceiver());
+    // Lightweight-fork: apply the static geolocation persona to this
+    // WebContents' context exactly once. device::GeolocationContext::SetOverride
+    // caches the override and replays it onto every GeolocationImpl bound later
+    // (services/device/geolocation/geolocation_context.cc), so all current and
+    // future frames report the spoofed position and never subscribe to the real
+    // network/system providers. Mirrors Emulation.setGeolocationOverride.
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (cmd.HasSwitch(switches::kPersonaLatitude) &&
+        cmd.HasSwitch(switches::kPersonaLongitude)) {
+      double latitude = 0.0;
+      double longitude = 0.0;
+      if (base::StringToDouble(
+              cmd.GetSwitchValueASCII(switches::kPersonaLatitude), &latitude) &&
+          base::StringToDouble(
+              cmd.GetSwitchValueASCII(switches::kPersonaLongitude),
+              &longitude)) {
+        // Optional horizontal accuracy (meters); default to a plausible GPS
+        // value so device::ValidateGeoposition accepts the position.
+        double accuracy = 40.0;
+        if (cmd.HasSwitch(switches::kPersonaAccuracy)) {
+          double parsed = 0.0;
+          if (base::StringToDouble(
+                  cmd.GetSwitchValueASCII(switches::kPersonaAccuracy),
+                  &parsed) &&
+              parsed >= 0.0) {
+            accuracy = parsed;
+          }
+        }
+        auto position = device::mojom::Geoposition::New();
+        position->latitude = latitude;
+        position->longitude = longitude;
+        position->accuracy = accuracy;
+        position->timestamp = base::Time::Now();
+        if (device::ValidateGeoposition(*position)) {
+          geolocation_context_->SetOverride(
+              device::mojom::GeopositionResult::NewPosition(
+                  std::move(position)));
+        }
+      }
+    }
   }
   return geolocation_context_.get();
 }
