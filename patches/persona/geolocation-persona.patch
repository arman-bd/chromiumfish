diff --git a/components/permissions/permission_context_base.cc b/components/permissions/permission_context_base.cc
index 171e53dd8d506..940b2f7816d01 100644
--- a/components/permissions/permission_context_base.cc
+++ b/components/permissions/permission_context_base.cc
@@ -13,6 +13,7 @@
 #include <utility>
 #include <variant>
 
+#include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/logging.h"
@@ -464,6 +465,32 @@ content::PermissionResult PermissionContextBase::GetPermissionStatus(
   }
 #endif  // BUILDFLAG(IS_ANDROID)
 
+  // Lightweight-fork: when a static geolocation persona is pinned on the command
+  // line (--persona-lat/--persona-lng), auto-grant the geolocation permission so
+  // the injected coordinates are actually served. The override installed in
+  // GeolocationContext is inert until the permission is GRANTED (see
+  // content/browser/geolocation/geolocation_service_impl.cc). Placed after the
+  // kill-switch, secure-origin and permissions-policy gates above, so a
+  // cross-origin iframe without allow="geolocation" is still denied. A precise
+  // GeolocationSetting is returned because GetPermissionLevel() CHECK-requires
+  // the setting to be present when kApproximateGeolocationPermission is enabled.
+  if (content_settings_type_ ==
+      content_settings::GeolocationContentSettingsType()) {
+    // Switch names mirror content/public/common/content_switches.cc; declared
+    // locally to avoid a content_switches.h dependency from this layer.
+    static constexpr char kPersonaLatSwitch[] = "persona-lat";
+    static constexpr char kPersonaLngSwitch[] = "persona-lng";
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (cmd.HasSwitch(kPersonaLatSwitch) && cmd.HasSwitch(kPersonaLngSwitch)) {
+      return content::PermissionResult(
+          PermissionStatus::GRANTED,
+          content::PermissionStatusSource::UNSPECIFIED,
+          PermissionSetting(GeolocationSetting{
+              /*approximate=*/PermissionOption::kAllowed,
+              /*precise=*/PermissionOption::kAllowed}));
+    }
+  }
+
   PermissionSetting retrieved_permission_data = GetPermissionStatusInternal(
       render_frame_host, requesting_origin, embedding_origin);
 
diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index 7edad76e875c0..f0b3e0d181d1a 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -41,6 +41,7 @@
 #include "base/observer_list.h"
 #include "base/process/process.h"
 #include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/strings/string_split.h"
 #include "base/strings/string_util.h"
 #include "base/strings/stringprintf.h"
@@ -197,6 +198,7 @@
 #include "net/http/http_util.h"
 #include "net/traffic_annotation/network_traffic_annotation.h"
 #include "partition_alloc/buildflags.h"
+#include "services/device/public/cpp/geolocation/geoposition.h"
 #include "services/device/public/mojom/wake_lock.mojom.h"
 #include "services/network/public/cpp/features.h"
 #include "services/network/public/cpp/request_destination.h"
@@ -6378,6 +6380,46 @@ device::mojom::GeolocationContext* WebContentsImpl::GetGeolocationContext() {
   if (!geolocation_context_) {
     GetDeviceService().BindGeolocationContext(
         geolocation_context_.BindNewPipeAndPassReceiver());
+    // Lightweight-fork: apply the static geolocation persona to this
+    // WebContents' context exactly once. device::GeolocationContext::SetOverride
+    // caches the override and replays it onto every GeolocationImpl bound later
+    // (services/device/geolocation/geolocation_context.cc), so all current and
+    // future frames report the spoofed position and never subscribe to the real
+    // network/system providers. Mirrors Emulation.setGeolocationOverride.
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (cmd.HasSwitch(switches::kPersonaLatitude) &&
+        cmd.HasSwitch(switches::kPersonaLongitude)) {
+      double latitude = 0.0;
+      double longitude = 0.0;
+      if (base::StringToDouble(
+              cmd.GetSwitchValueASCII(switches::kPersonaLatitude), &latitude) &&
+          base::StringToDouble(
+              cmd.GetSwitchValueASCII(switches::kPersonaLongitude),
+              &longitude)) {
+        // Optional horizontal accuracy (meters); default to a plausible GPS
+        // value so device::ValidateGeoposition accepts the position.
+        double accuracy = 40.0;
+        if (cmd.HasSwitch(switches::kPersonaAccuracy)) {
+          double parsed = 0.0;
+          if (base::StringToDouble(
+                  cmd.GetSwitchValueASCII(switches::kPersonaAccuracy),
+                  &parsed) &&
+              parsed >= 0.0) {
+            accuracy = parsed;
+          }
+        }
+        auto position = device::mojom::Geoposition::New();
+        position->latitude = latitude;
+        position->longitude = longitude;
+        position->accuracy = accuracy;
+        position->timestamp = base::Time::Now();
+        if (device::ValidateGeoposition(*position)) {
+          geolocation_context_->SetOverride(
+              device::mojom::GeopositionResult::NewPosition(
+                  std::move(position)));
+        }
+      }
+    }
   }
   return geolocation_context_.get();
 }
